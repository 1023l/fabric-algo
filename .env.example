# fabric-algo 环境变量配置示例（复制为 .env 后填写；.env 不入库）

# ── ① 数据问答 Agent（LLM 文本模型，OpenAI 兼容接口）──
# DeepSeek 示例
QA_LLM_API_KEY=sk-xxxx
QA_LLM_BASE_URL=https://api.deepseek.com
QA_LLM_MODEL=deepseek-chat
# 通义示例: BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, MODEL=qwen-plus
# 本地 vLLM 示例: BASE_URL=http://127.0.0.1:8002/v1
# QA_LLM_MAX_STEPS=10

# ── ② VLM 视觉质检（视觉语言模型，OpenAI 兼容接口）──
# 阿里云 DashScope 示例（qwen-vl-max / qwen-vl-plus）
VLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=sk-xxxx
VLM_MODEL=qwen-vl-max
# 本地 vLLM 部署 Qwen-VL 示例（Key 任意非空）:
# VLM_API_BASE=http://127.0.0.1:8002/v1
# VLM_API_KEY=local
# VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
# VLM_TIMEOUT=60
